<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dockbot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files, test scenarios and end-to-end tests for ArUco docking.</description>
  <maintainer email="pavanmp1402@gmail.com">Pavan Patil</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>dockbot_gazebo</depend>
  <depend>dockbot_perception</depend>
  <depend>dockbot_docking</depend>
  <depend>dockbot_description</depend>
  <depend>dockbot_interfaces</depend>
  <depend>rviz2</depend>
  <depend>ros_gz_sim</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
