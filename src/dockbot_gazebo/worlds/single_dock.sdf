<?xml version="1.0"?>
<!-- Copyright 2026 Pavan Patil, SPDX-License-Identifier: Apache-2.0
     Open floor with one marker (ID 0) on a stand, for basic approach tests. -->
<sdf version="1.9">
  <world name="single_dock">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://aruco_marker_0</uri>
      <name>marker_0</name>
      <pose>3 0 0.2 0 0 3.14159</pose>
    </include>
    <include>
      <uri>model://dock_stand</uri>
      <name>stand_0</name>
      <pose>3 0 0.2 0 0 3.14159</pose>
    </include>
  </world>
</sdf>
