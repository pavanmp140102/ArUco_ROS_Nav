<?xml version="1.0"?>
<!-- Copyright 2026 Pavan Patil, SPDX-License-Identifier: Apache-2.0
     Walled 7 m x 7 m room with five markers (poses in config/markers.yaml) and obstacles. -->
<sdf version="1.9">
  <world name="docking_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 7.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 7.2 1</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 7.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 7.2 1</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.55 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.2 0.1 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>7.2 0.1 1</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.55 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.2 0.1 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>7.2 0.1 1</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://aruco_marker_0</uri>
      <name>marker_0</name>
      <pose>3.45 1 0.2 0 0 3.14159</pose>
    </include>
    <include>
      <uri>model://aruco_marker_1</uri>
      <name>marker_1</name>
      <pose>3.45 1.6 0.2 0 0 3.14159</pose>
    </include>
    <include>
      <uri>model://aruco_marker_2</uri>
      <name>marker_2</name>
      <pose>-1.5 3.45 0.2 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://aruco_marker_3</uri>
      <name>marker_3</name>
      <pose>-3.45 -1 0.2 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_marker_4</uri>
      <name>marker_4</name>
      <pose>1.5 -2.5 0.2 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://dock_stand</uri>
      <name>stand_4</name>
      <pose>1.5 -2.5 0.2 0 0 1.5708</pose>
    </include>
    <model name="box_a">
      <static>true</static>
      <pose>2.6 -1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_b">
      <static>true</static>
      <pose>-2.4 1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.8 0.5</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_c">
      <static>true</static>
      <pose>-0.5 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.8 0.7 0.2 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>0.5 2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.6 1</ambient><diffuse>0.5 0.3 0.6 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="pillar_occluder">
      <static>true</static>
      <pose>0.25 1.975 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.7 1</ambient><diffuse>0.2 0.5 0.7 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
